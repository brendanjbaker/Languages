import <stdio>

int sum_range(begin_inclusive: int, end_inclusive: int):
    sum: int = 0
    end_exclusive: int = end_inclusive + 1

    for n in begin_inclusive..end_exclusive:
        sum = sum + n
    end

    return sum
end

prop int main():
    sum: int = sum_range(0, 100)

    printf("%d\n", sum)

    return 0
end
